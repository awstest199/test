"""Orchestrator: LLM-decomposes the incoming prompt into client_id +
rule_filter (entity resolution from prose, not calculation-parameter
parsing -- see services/llm_service.decompose_prompt for why), then
deterministically loads and filters the skills manifest. Fan-out #1
(route_to_skills) sends one branch per remaining skill -- nothing here
assumes a fixed skill count.
"""

from datetime import datetime, timezone

from langgraph.types import Send

from src.config.settings import get_settings
from src.graph.state import GraphState
from src.logging_setup import get_logger
from src.services import llm_service, manifest_service

logger = get_logger()


async def orchestrator(state: GraphState) -> dict:
    log = logger.bind(request_id=state["request_id"])
    settings = get_settings()

    log.info("decompose_prompt_start", prompt=state["prompt"][:300])
    intent = llm_service.decompose_prompt(state["prompt"], settings)
    client_id = intent.get("client_id")
    rule_filter = intent.get("rule_filter")
    log.info("decompose_prompt_done", client_id=client_id, rule_filter=rule_filter)

    if not client_id:
        log.error("decompose_prompt_missing_client_id", prompt=state["prompt"][:300])
        return {
            "client_id": None,
            "rule_filter": rule_filter,
            "skills": [],
            "status": "FAILED",
            "errors": ["Could not resolve a client_id from the prompt"],
        }

    manifest_bucket = state.get("manifest_bucket") or settings.skills_manifest_bucket
    manifest_key = state.get("manifest_key") or settings.skills_manifest_key

    all_skills = manifest_service.load_manifest(manifest_bucket, manifest_key, settings.aws_region)
    skills = manifest_service.filter_skills(all_skills, client_id, rule_filter)
    log.info("manifest_filtered", total_skills=len(all_skills), applicable_skills=len(skills))

    return {
        "client_id": client_id,
        "rule_filter": rule_filter,
        "manifest_bucket": manifest_bucket,
        "manifest_key": manifest_key,
        "skills": skills,
        "status": "RUNNING",
        "invoked_at": datetime.now(timezone.utc).isoformat(),
    }


def route_to_skills(state: GraphState):
    if state.get("status") == "FAILED" or not state.get("skills"):
        return "report"
    return [
        Send(
            "skill_subgraph",
            {"request_id": state["request_id"], "client_id": state["client_id"], "skill": skill},
        )
        for skill in state["skills"]
    ]
