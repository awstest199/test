"""Bedrock Converse wrapper -- used by the orchestrator (decompose_prompt,
always runs) and the report node (summarize, optional, gated behind
ENABLE_LLM_SUMMARY).

decompose_prompt extracts exactly two fields from a long-form analyst
prompt: client_id and rule_filter. The prompt's own methodology language
("consider the lag of fraud tagging", "trend multiplier if fraud
continues to deteriorate") is NOT re-derived here -- that describes the
standing projection logic baked into evaluators/lag_trend_projection.py,
not a per-request parameter.
"""

import json
import re

import boto3

from src.config.settings import AppSettings
from src.logging_setup import get_logger
from src.models.results import PromptIntent

logger = get_logger()

_DECOMPOSE_SYSTEM_PROMPT = (
    "You are a request router for a fraud-detection rule agent. Given a natural-language "
    "request from an analyst, extract exactly two fields as JSON: "
    '{"client_id": "<the client/portfolio id the request refers to, or null if not mentioned>", '
    '"rule_filter": ["<rule_id or skill_id>", ...] or null if the request does not name specific rules}. '
    "Ignore any methodology or calculation instructions in the prompt (mentions of lag, trend "
    "multipliers, projections, stress scenarios, etc.) -- those describe standing analysis logic "
    "the system always applies, not per-request parameters to extract. "
    "Respond with ONLY the JSON object, no other text."
)


def _client(settings: AppSettings):
    return boto3.client("bedrock-runtime", region_name=settings.aws_region)


def _extract_json(text: str) -> dict:
    try:
        return json.loads(text)
    except json.JSONDecodeError:
        match = re.search(r"\{.*\}", text, re.DOTALL)
        if not match:
            raise ValueError(f"could not extract JSON from LLM response: {text!r}")
        return json.loads(match.group(0))


def decompose_prompt(prompt: str, settings: AppSettings) -> PromptIntent:
    if settings.llm_mock:
        return _mock_decompose(prompt)

    client = _client(settings)
    response = client.converse(
        modelId=settings.bedrock_model_id,
        system=[{"text": _DECOMPOSE_SYSTEM_PROMPT}],
        messages=[{"role": "user", "content": [{"text": prompt}]}],
        inferenceConfig={"temperature": 0.0, "maxTokens": 300},
    )
    text = response["output"]["message"]["content"][0]["text"]
    data = _extract_json(text)
    return PromptIntent(client_id=data.get("client_id"), rule_filter=data.get("rule_filter"))


def _mock_decompose(prompt: str) -> PromptIntent:
    """Small heuristic mock for local dev (LLM_MOCK=true) only -- not a
    substitute for the real model. Looks for an upper-case token that reads
    like a client_id, and a few rule keywords."""
    logger.info("llm_mock_decompose", prompt=prompt[:200])

    client_id = None
    for token in prompt.replace(",", " ").replace(".", " ").split():
        cleaned = token.strip(":;")
        letters_only = cleaned.replace("_", "")
        if len(cleaned) >= 3 and letters_only.isalpha() and letters_only.isupper():
            client_id = cleaned
            break

    lowered = prompt.lower()
    keyword_to_rule = {
        "velocity": "3",
        "volume-spike": "1",
        "volume spike": "1",
        "volume": "1",
        "segment": "5",
        "share": "5",
    }
    matched = {rid for kw, rid in keyword_to_rule.items() if kw in lowered}
    rule_filter = sorted(matched) if matched else None

    return PromptIntent(client_id=client_id, rule_filter=rule_filter)


def summarize(results: list[dict], settings: AppSettings) -> str:
    if not results:
        return "No skills were evaluated for this run."

    if settings.llm_mock:
        flagged = [r for r in results if r["status"] == "FLAGGED"]
        return f"{len(flagged)} of {len(results)} rules flagged in this run."

    lines = [f"- {r['name']}: {r['status']} (metric={r.get('metric_value')})" for r in results]
    user_text = (
        "Summarize this fraud rule evaluation run in 2-3 sentences for a risk analyst:\n"
        + "\n".join(lines)
    )
    client = _client(settings)
    response = client.converse(
        modelId=settings.bedrock_model_id,
        messages=[{"role": "user", "content": [{"text": user_text}]}],
        inferenceConfig={"temperature": 0.3, "maxTokens": 300},
    )
    return response["output"]["message"]["content"][0]["text"]
