"""Report node: builds the MVP1 simple summary (client_id, run metadata,
one row per skill), optionally adds a short LLM executive summary, renders
and uploads to the report output S3 bucket -- a distinct bucket from the
skills-manifest input bucket. Not the full multi-section analyst dashboard
(monthly trend charts, predictor tables, heatmap, 3-scenario projection,
prioritized recommendations) seen in the real reference reports -- that's
an explicitly deferred follow-up; SkillResult.worker_outputs_used already
carries the richer numbers needed for it later.
"""

from datetime import datetime, timezone

from src.config.settings import get_settings
from src.graph.state import GraphState
from src.logging_setup import get_logger
from src.services import llm_service, report_service

logger = get_logger()


async def report_node(state: GraphState) -> dict:
    log = logger.bind(request_id=state["request_id"])

    if state.get("status") == "FAILED":
        log.error("report_skipped_failed_run", errors=state.get("errors"))
        return {"status": "FAILED"}

    settings = get_settings()
    results = state.get("results", [])
    flagged_count = sum(1 for r in results if r["status"] == "FLAGGED")
    log.info("report_start", total_results=len(results), flagged_count=flagged_count)

    summary_text = None
    if settings.enable_llm_summary:
        summary_text = llm_service.summarize(results, settings)

    context = {
        "request_id": state["request_id"],
        "client_id": state.get("client_id") or "",
        "invoked_at": state.get("invoked_at") or datetime.now(timezone.utc).isoformat(),
        "prompt": state.get("prompt", ""),
        "results": results,
        "flagged_count": flagged_count,
        "total_count": len(results),
        "summary_text": summary_text,
    }

    html = report_service.render(context)
    report_s3_uri = report_service.upload(
        html, settings, state["request_id"], state.get("client_id") or "unknown"
    )
    log.info("report_uploaded", report_s3_uri=report_s3_uri)

    return {
        "report_html": html,
        "report_s3_uri": report_s3_uri,
        "status": "COMPLETED",
    }
