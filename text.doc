"""Plain TypedDict contracts for evaluation results and the MVP1 report context."""

from typing import Literal, Optional, TypedDict

from src.models.manifest import ThresholdSpec


class SkillResult(TypedDict):
    skill_id: str
    rule_id: str
    client_id: str
    name: str
    severity: str
    status: Literal["PASS", "FLAGGED", "ERROR", "SKIPPED"]
    metric_value: Optional[float]
    threshold_used: ThresholdSpec
    worker_outputs_used: dict  # {agent_role: parsed_answer} snapshot, for audit
    evaluated_at: str
    error: Optional[str]


class PromptIntent(TypedDict):
    """Output of llm_service.decompose_prompt -- the only two fields the graph needs."""

    client_id: Optional[str]
    rule_filter: Optional[list[str]]


class ReportContext(TypedDict):
    request_id: str
    client_id: str
    invoked_at: str
    prompt: str
    results: list[SkillResult]
    flagged_count: int
    total_count: int
    summary_text: Optional[str]  # only set when ENABLE_LLM_SUMMARY=true
