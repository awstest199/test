"""Bedrock AgentCore Runtime entrypoint -- the container contract a future
deployment step needs to satisfy: instantiate BedrockAgentCoreApp(),
decorate invoke(payload) with @app.entrypoint, call app.run() under
__main__. The framework binds port 8080 itself; no hand-written HTTP
server here.

Stateless by design: each invocation runs one fully independent graph
execution (see src/graph/build_graph.py) with no AgentCore Memory
integration and no state retained between calls.
"""

import uuid

from bedrock_agentcore.runtime import BedrockAgentCoreApp

from src.config.settings import get_settings
from src.graph.build_graph import build_graph
from src.logging_setup import configure_logging, get_logger

app = BedrockAgentCoreApp()
_graph = build_graph()  # compiled once at cold start, reused across invocations


@app.entrypoint
async def invoke(payload: dict) -> dict:
    settings = get_settings()
    configure_logging(settings)

    request_id = payload.get("request_id") or str(uuid.uuid4())
    logger = get_logger(request_id=request_id)

    prompt = payload.get("prompt")
    if not prompt:
        logger.error("invoke_missing_prompt")
        return {"request_id": request_id, "status": "FAILED", "error": "payload.prompt is required"}

    initial_state = {
        "request_id": request_id,
        "prompt": prompt,
        "client_id": None,
        "rule_filter": None,
        "manifest_bucket": payload.get("manifest_bucket") or settings.skills_manifest_bucket,
        "manifest_key": payload.get("manifest_key") or settings.skills_manifest_key,
        "skills": [],
        "results": [],
        "errors": [],
        "report_html": None,
        "report_s3_uri": None,
        "status": "PENDING",
    }

    final_state = await _graph.ainvoke(initial_state)
    results = final_state.get("results", [])

    return {
        "request_id": request_id,
        "status": final_state.get("status"),
        "client_id": final_state.get("client_id"),
        "report_s3_uri": final_state.get("report_s3_uri"),
        "total_skills_evaluated": len(results),
        "flagged_count": sum(1 for r in results if r["status"] == "FLAGGED"),
        "errors": final_state.get("errors", []),
    }


if __name__ == "__main__":
    app.run()
