"""Renders the MVP1 report (simple summary table, not the full multi-section
analyst dashboard -- see the plan) and uploads it to the report output S3
bucket, which is distinct from the skills-manifest input bucket.
"""

from pathlib import Path

import boto3
from jinja2 import Environment, FileSystemLoader, select_autoescape

from src.config.settings import AppSettings
from src.logging_setup import get_logger
from src.models.results import ReportContext

logger = get_logger()

_TEMPLATES_DIR = Path(__file__).resolve().parent.parent / "templates"

_env = Environment(
    loader=FileSystemLoader(str(_TEMPLATES_DIR)),
    autoescape=select_autoescape(["html"]),
)


def render(context: ReportContext) -> str:
    template = _env.get_template("report.html.j2")
    return template.render(**context)


def upload(html: str, settings: AppSettings, request_id: str, client_id: str) -> str:
    key = f"{settings.report_output_prefix}{client_id}/{request_id}.html"

    if not settings.report_output_bucket:
        logger.warning("report_output_bucket_unset", key=key)
        return f"local://{key}"

    client = boto3.client("s3", region_name=settings.aws_region)
    client.put_object(
        Bucket=settings.report_output_bucket,
        Key=key,
        Body=html.encode("utf-8"),
        ContentType="text/html",
    )
    return f"s3://{settings.report_output_bucket}/{key}"
