"""Fan-out #2 (conditional-edge routing function, wired at the subgraph's
START): one Send("agent_worker", ...) per entry in THIS skill's
required_agents list. M is whatever len(required_agents) is for this
skill -- nothing here assumes a fixed count.
"""

from langgraph.types import Send

from src.graph.state import SkillState


def dispatch_agents(state: SkillState):
    skill = state["skill"]
    threshold = skill.get("threshold") or {}

    return [
        Send(
            "agent_worker",
            {
                "request_id": state["request_id"],
                "client_id": state["client_id"],
                "rule_id": skill["rule_id"],
                "agent_role": agent["agent_role"],
                "question_template": agent["question_template"],
                "window_hours": threshold.get("window_hours"),
            },
        )
        for agent in skill["required_agents"]
    ]
