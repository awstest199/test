"""Two separate state schemas on purpose: the top-level graph's dynamic
fan-out is over `skills` (fan-out #1), the per-skill subgraph's dynamic
fan-out is over that one skill's `required_agents` (fan-out #2). Mixing
both into one flat schema would blur which reducer applies to which
fan-out level.
"""

import operator
from typing import Annotated, Literal, Optional, TypedDict

from src.models.manifest import SkillManifestEntry
from src.models.results import SkillResult


# --- top-level graph ---
class GraphState(TypedDict):
    request_id: str
    prompt: str  # raw natural-language prompt from Lambda
    client_id: Optional[str]  # populated by the LLM decomposition step
    rule_filter: Optional[list[str]]  # rule_ids/skill_ids requested, or None = all
    invoked_at: str
    manifest_bucket: str
    manifest_key: str
    skills: list[SkillManifestEntry]
    results: Annotated[list[SkillResult], operator.add]  # fan-in #1 reducer
    errors: Annotated[list[str], operator.add]
    report_html: Optional[str]
    report_s3_uri: Optional[str]
    status: Literal["PENDING", "DECOMPOSING", "RUNNING", "COMPLETED", "FAILED"]


# --- per-skill subgraph ---
class SkillState(TypedDict):
    request_id: str
    client_id: str
    skill: SkillManifestEntry
    worker_outputs: Annotated[dict, operator.or_]  # fan-in #2 reducer, {agent_role: parsed_answer}
    result: Optional[SkillResult]


# --- per-agent-worker branch state (the payload each Send carries) ---
class AgentWorkerInput(TypedDict, total=False):
    request_id: str
    client_id: str
    rule_id: str
    agent_role: str
    question_template: str
    window_hours: Optional[int]  # from the skill's threshold, if the template references {window_hours}
