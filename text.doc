"""
Correctness checks -- finalized DQ table row 9.
"""

from .registry import CheckResult


def check_nan_infinity(df):
    """Row 9: divide-by-zero protection, not covered by the no-null
    check -- a NaN/Infinity value isn't null, it's a value that exists
    but the aggregation math broke (e.g. Rule 1's z-score dividing by a
    zero-variance baseline_stddev, or Rule 3's share dividing by a
    zero-account cohort)."""
    bad_rows = df.filter("isnan(output_metric) OR abs(output_metric) = double('inf')")
    bad_count = bad_rows.count()
    return CheckResult(
        check_name="nan_infinity",
        passed=(bad_count == 0),
        severity="block",
        details=f"{bad_count} row(s) with NaN/Infinity output_metric",
    )
