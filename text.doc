# Copy to .env for local dev. Never commit the real .env (git-ignored) --
# dev/prod values come from wherever the AgentCore Runtime deployment sets
# environment variables, not from this file.

APP_ENV=local
AWS_REGION=us-east-1

# Knowledge Base -- single KB, every agent_worker calls the same one
KNOWLEDGE_BASE_ID=
KB_MOCK=true

# LLM (prompt decomposition + optional executive summary)
LLM_MOCK=true
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
ENABLE_LLM_SUMMARY=false

# Skills manifest (S3). Leave SKILLS_MANIFEST_BUCKET unset locally to use
# the bundled app/fixtures/skills.md instead.
SKILLS_MANIFEST_BUCKET=
SKILLS_MANIFEST_KEY=skills/skills.md

# Report output (S3) -- a distinct bucket from the manifest input bucket.
# Leave unset locally; report_service logs a local:// URI instead of
# uploading.
REPORT_OUTPUT_BUCKET=
REPORT_OUTPUT_PREFIX=reports/

# Logging
LOG_LEVEL=DEBUG
ENABLE_WATCHTOWER=false
CLOUDWATCH_LOG_GROUP=/rule-agent/langgraph
