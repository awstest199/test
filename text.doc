"""Single Knowledge Base query service.

Every agent_worker instance, regardless of which skill/rule it's serving,
calls this same module against the same KNOWLEDGE_BASE_ID. The KB resolves
NL2SQL and executes against Redshift internally -- this service never
builds SQL or talks to Redshift directly, and never needs Secrets Manager
credentials.
"""

import json
import re

import boto3

from src.config.settings import AppSettings
from src.logging_setup import get_logger

logger = get_logger()


def _client(settings: AppSettings):
    return boto3.client("bedrock-agent-runtime", region_name=settings.aws_region)


def _extract_json(text: str) -> dict:
    try:
        return json.loads(text)
    except json.JSONDecodeError:
        match = re.search(r"\{.*\}", text, re.DOTALL)
        if not match:
            raise ValueError(f"KB answer was not parseable as JSON: {text!r}")
        return json.loads(match.group(0))


def query(question: str, settings: AppSettings) -> dict:
    """Calls retrieve_and_generate against the single configured Knowledge
    Base and parses the generated answer as JSON.

    Raises on total parse failure -- callers (agent_worker) are responsible
    for catching that and turning it into a per-worker error marker rather
    than letting one bad answer crash the whole skill.
    """
    if settings.kb_mock:
        return _mock_answer(question)

    client = _client(settings)
    response = client.retrieve_and_generate(
        input={"text": question},
        retrieveAndGenerateConfiguration={
            "type": "KNOWLEDGE_BASE",
            "knowledgeBaseConfiguration": {
                "knowledgeBaseId": settings.knowledge_base_id,
                "modelArn": settings.bedrock_model_id,
            },
        },
    )
    answer_text = response["output"]["text"]
    return _extract_json(answer_text)


def _mock_answer(question: str) -> dict:
    """Canned mock fields for local dev (KB_MOCK=true) -- a superset covering
    what every current evaluator expects, regardless of which
    question_template was actually asked."""
    logger.info("kb_mock_query", question=question[:160])
    return {

    }
