"""Compiles the per-skill subgraph used as the top-level graph's
skill_subgraph node (see src/graph/build_graph.py). Fan-out #2
(dispatch_agents -> N x agent_worker) is sized by
len(skill['required_agents']) at runtime -- nothing here assumes a fixed
worker count. Wiring:

    START -> dispatch_agents (conditional: Send x M) -> agent_worker (x M, parallel)
          -> reduce_agent -> END
"""

from langgraph.graph import END, START, StateGraph

from src.graph.skill_subgraph.nodes.agent_worker import agent_worker
from src.graph.skill_subgraph.nodes.dispatch_agents import dispatch_agents
from src.graph.skill_subgraph.nodes.reduce_agent import reduce_agent
from src.graph.state import SkillState


def build_skill_subgraph():
    graph = StateGraph(SkillState)
    graph.add_node("agent_worker", agent_worker)
    graph.add_node("reduce_agent", reduce_agent)

    graph.add_conditional_edges(START, dispatch_agents, ["agent_worker"])
    graph.add_edge("agent_worker", "reduce_agent")
    graph.add_edge("reduce_agent", END)

    return graph.compile()


skill_subgraph_app = build_skill_subgraph()
