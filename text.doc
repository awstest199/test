"""
Coverage/Lineage checks -- finalized DQ table row 12.
"""

from .registry import CheckResult

LINEAGE_COLUMNS = ["run_id", "snapshot_date", "portfolio_id", "rule_id"]


def check_audit_traceability(df):
    """Row 12: every output row can be traced to which run, date,
    portfolio, and rule produced it. Kept separate from Output
    Completeness (row 5), which operates at a different granularity
    (portfolio x rule coverage vs. row-level lineage) -- deliberately
    not merged."""
    missing_cols = [c for c in LINEAGE_COLUMNS if c not in df.columns]
    if missing_cols:
        return CheckResult(
            check_name="audit_traceability",
            passed=False,
            severity="block",
            details=f"missing lineage column(s): {missing_cols}",
        )
    filter_expr = " OR ".join(f"{c} IS NULL" for c in LINEAGE_COLUMNS)
    bad_count = df.filter(filter_expr).count()
    return CheckResult(
        check_name="audit_traceability",
        passed=(bad_count == 0),
        severity="block",
        details=f"{bad_count} row(s) missing one or more lineage fields {LINEAGE_COLUMNS}",
    )
