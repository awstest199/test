"""Lambda trigger: forwards a natural-language prompt to the Rule Agent's
AgentCore Runtime endpoint via invoke_agent_runtime. No pre-structured
fields -- the orchestrator's own LLM decomposition step resolves
client_id/rule_filter from the prompt text (see src/services/llm_service.py).

Where the prompt string itself comes from (a fixed template built per
scheduled client, a human-triggered request, etc.) is a business-owner
decision, out of scope here -- this handler just forwards whatever prompt
it's given.
"""

import json
import os
import uuid

import boto3

_client = boto3.client("bedrock-agentcore", region_name=os.environ.get("AWS_REGION", "us-east-1"))
_AGENT_RUNTIME_ARN = os.environ.get("AGENT_RUNTIME_ARN")


def handler(event: dict, context) -> dict:
    if not _AGENT_RUNTIME_ARN:
        raise RuntimeError("AGENT_RUNTIME_ARN environment variable is not set")

    prompt = event.get("prompt")
    if not prompt:
        raise ValueError("event.prompt is required, e.g. 'Run fraud detection for client AMAZON_PL'")

    request_id = event.get("request_id") or str(uuid.uuid4())
    payload = json.dumps(
        {
            "request_id": request_id,
            "prompt": prompt,
            "manifest_bucket": event.get("manifest_bucket"),
            "manifest_key": event.get("manifest_key"),
        }
    ).encode("utf-8")

    response = _client.invoke_agent_runtime(
        agentRuntimeArn=_AGENT_RUNTIME_ARN,
        runtimeSessionId=request_id,
        payload=payload,
        contentType="application/json",
        accept="application/json",
    )
    body = response["response"].read()

    return {"statusCode": 200, "body": body.decode("utf-8")}
