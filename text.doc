"""
Shared write layer for curated/aggregated data.

Starter implementation -- confirm the actual Iceberg write mode and
partitioning strategy before this goes anywhere near production.
"""


def write_curated_table(df, table_name, mode="append"):
    if mode == "append":
        df.writeTo(table_name).append()
    elif mode == "overwrite_partitions":
        df.writeTo(table_name).overwritePartitions()
    else:
        raise ValueError(f"Unsupported write mode: {mode!r}")
