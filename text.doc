"""Environment/config for the Rule Agent LangGraph app.

Deliberately simple for MVP1 (no pydantic-settings) -- mirrors the
per-service mock-flag pattern from capstone_project/fraude/config.py:
each external dependency gets its own MOCK flag (KB_MOCK, LLM_MOCK)
rather than one global switch, so you can flip one to "real" while the
other stays mocked during incremental rollout.
"""

from dataclasses import dataclass, field
import os

from dotenv import load_dotenv

load_dotenv()


def _flag(name: str, default: str = "true") -> bool:
    return os.environ.get(name, default).lower() != "false"


@dataclass(frozen=True)
class AppSettings:
    app_env: str = field(default_factory=lambda: os.environ.get("APP_ENV", "local"))
    aws_region: str = field(default_factory=lambda: os.environ.get("AWS_REGION", "us-east-1"))

    # Knowledge Base -- single KB, all agent_worker instances hit the same one
    knowledge_base_id: str = field(default_factory=lambda: os.environ.get("KNOWLEDGE_BASE_ID", ""))
    kb_mock: bool = field(default_factory=lambda: _flag("KB_MOCK"))

    # LLM (prompt decomposition + optional summary)
    llm_mock: bool = field(default_factory=lambda: _flag("LLM_MOCK"))
    bedrock_model_id: str = field(
        default_factory=lambda: os.environ.get(
            "BEDROCK_MODEL_ID", "anthropic.claude-3-5-haiku-20241022-v1:0"
        )
    )

    # Skills manifest (S3)
    skills_manifest_bucket: str = field(default_factory=lambda: os.environ.get("SKILLS_MANIFEST_BUCKET", ""))
    skills_manifest_key: str = field(
        default_factory=lambda: os.environ.get("SKILLS_MANIFEST_KEY", "skills/skills.md")
    )

    # Report output (S3) -- a distinct bucket from the manifest input bucket
    report_output_bucket: str = field(default_factory=lambda: os.environ.get("REPORT_OUTPUT_BUCKET", ""))
    report_output_prefix: str = field(
        default_factory=lambda: os.environ.get("REPORT_OUTPUT_PREFIX", "reports/")
    )

    # Optional executive-summary LLM call in the report node
    enable_llm_summary: bool = field(default_factory=lambda: _flag("ENABLE_LLM_SUMMARY", "false"))

    # Logging
    log_level: str = field(default_factory=lambda: os.environ.get("LOG_LEVEL", "INFO"))
    enable_watchtower: bool = field(default_factory=lambda: _flag("ENABLE_WATCHTOWER", "false"))
    cloudwatch_log_group: str = field(
        default_factory=lambda: os.environ.get("CLOUDWATCH_LOG_GROUP", "/rule-agent/langgraph")
    )


def get_settings() -> AppSettings:
    return AppSettings()
