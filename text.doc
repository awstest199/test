"""
Registry for rule-specific Stage 3 (post-aggregation) DQ checks.

Generic checks (completeness.py, correctness.py, reliability.py,
coverage_lineage.py, structural_integrity.py) do NOT use this registry --
they are plain functions imported directly into run_metricdqrules.py's
GENERIC_CHECKS list and always run, regardless of which rules are active
this cycle.

This registry exists only for checks that vary per rule. Confirmed scope
(2026-08-06): only Rule 2 (velocity, user's conversational numbering) has
a rule-specific checks module (velocityRule_checks.py) -- Rule 1 (volume
spike) and Rule 3 (segment share) do not get their own modules right now.
"""

from dataclasses import dataclass
from typing import Callable

_REGISTRY: dict[str, list[Callable]] = {}


def register_rule_check(rule_id: str):
    """Decorator: register a check function under a specific rule_id."""
    def decorator(fn: Callable) -> Callable:
        _REGISTRY.setdefault(rule_id, []).append(fn)
        return fn
    return decorator


def get_checks_for_rule(rule_id: str) -> list[Callable]:
    """Every check registered for rule_id, or [] if it has none."""
    return _REGISTRY.get(rule_id, [])


@dataclass
class CheckResult:
    check_name: str
    passed: bool
    severity: str  # "block" or "warn"
    details: str = ""
