"""
Writes Stage 3 DQ check results out.

Destination table/schema is a separate, still-undecided table -- not the
same as whatever the aggregation output ("base matrix") table ends up
being. This is a temporary/starter implementation; confirm the real
destination before this goes anywhere near production.
"""


def write_results(spark, results, run_id):
    rows = [
        {
            "run_id": run_id,
            "check_name": r.check_name,
            "passed": r.passed,
            "severity": r.severity,
            "details": r.details,
        }
        for r in results
    ]
    if not rows:
        return
    results_df = spark.createDataFrame(rows)
    # TODO: destination table name/location not finalized yet -- confirm
    # before this goes anywhere near production.
    results_df.write.format("iceberg").mode("append").saveAsTable(
        "dq_results.metricdqrules_verdicts"
    )
