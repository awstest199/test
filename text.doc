"""Placeholder reduce-step evaluator.

The real per-rule comparison logic (base/baseline matrix, from
baseline_data_agent, vs. the near-real-time matrix from aggregation_agent)
is intentionally NOT implemented yet. This just proves the plumbing --
dynamic worker fan-out/fan-in, dispatch by skill_type -- end to end, and
returns a SKIPPED result carrying both matrices for inspection.

When the real comparison logic is ready: add dedicated evaluator
functions (one per skill_type, or shared where the math is genuinely the
same) and wire them into EVALUATORS in base.py. Nothing else in the graph
needs to change -- reduce_agent already dispatches purely by skill_type.
"""

from src.graph.evaluators import base
from src.logging_setup import get_logger

logger = get_logger()


def evaluate(skill: dict, worker_outputs: dict) -> dict:
    base_matrix = worker_outputs.get("baseline_data_agent")
    realtime_matrix = worker_outputs.get("aggregation_agent")

    logger.info(
        "placeholder_evaluator_called",
        skill_id=skill["skill_id"],
        skill_type=skill["skill_type"],
        has_base_matrix=base_matrix is not None,
        has_realtime_matrix=realtime_matrix is not None,
    )

    return base.build_result(
        skill,
        status="SKIPPED",
        metric_value=None,
        worker_outputs=worker_outputs,
        error="Comparison logic not yet implemented -- placeholder only.",
    )
