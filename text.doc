#!/usr/bin/env python3
"""
Update an existing Amazon Bedrock Structured Knowledge Base with semantic
generation context loaded from a YAML file.

Requirements:
    pip install boto3 pyyaml

AWS credentials must already be configured (for example through SSO/SAML,
environment variables, or an AWS profile).

Usage:
    python update_kb_generation_context.py fraud_semantic.yml

Optional:
    python update_kb_generation_context.py fraud_semantic.yml --profile my-profile
    python update_kb_generation_context.py fraud_semantic.yml --no-ingestion
"""

import argparse
import copy
import json
import sys

import boto3
import yaml
from botocore.exceptions import BotoCoreError, ClientError


def parse_args():
    p = argparse.ArgumentParser()
    p.add_argument("yaml_file", help="Path to semantic YAML file")
    p.add_argument("--profile", help="Optional AWS CLI profile name")
    p.add_argument("--no-ingestion", action="store_true",
                   help="Update the KB but do not start an ingestion job")
    return p.parse_args()


def load_yaml(path):
    with open(path, "r", encoding="utf-8") as f:
        return yaml.safe_load(f)


def validate_context(ctx):
    tables = ctx.get("tables", [])
    curated = ctx.get("curated_queries", [])

    if len(tables) > 50:
        raise ValueError("Bedrock allows at most 50 generation-context tables.")

    for table in tables:
        name = table.get("name", "")
        if name.count(".") < 2:
            raise ValueError(
                f"Table name must be fully qualified as database.schema.table: {name}"
            )

    return {
        "tables": [
            {
                "name": t["name"],
                **({"description": t["description"]} if t.get("description") else {}),
                **({"inclusion": t["inclusion"]} if t.get("inclusion") else {}),
                **({
                    "columns": [
                        {
                            **({"name": c["name"]} if c.get("name") else {}),
                            **({"description": c["description"]} if c.get("description") else {}),
                            **({"inclusion": c["inclusion"]} if c.get("inclusion") else {}),
                        }
                        for c in t.get("columns", [])
                    ]
                } if t.get("columns") else {}),
            }
            for t in tables
        ],
        "curatedQueries": [
            {
                "naturalLanguage": q["natural_language"],
                "sql": q["sql"].strip(),
            }
            for q in curated
        ],
    }


def make_session(profile, region):
    if profile:
        return boto3.Session(profile_name=profile, region_name=region)
    return boto3.Session(region_name=region)


def start_ingestion_if_possible(client, kb_id):
    """
    Structured KBs can have a data source that can be resynced after the KB update.
    If exactly one data source exists, start an ingestion job automatically.
    Otherwise print the IDs so the user can choose.
    """
    paginator = client.get_paginator("list_data_sources")
    sources = []
    for page in paginator.paginate(knowledgeBaseId=kb_id):
        sources.extend(page.get("dataSourceSummaries", []))

    if not sources:
        print("\nNo data source found. KB update is complete; no ingestion started.")
        return

    if len(sources) == 1:
        ds = sources[0]
        print(f"\nStarting ingestion for data source: {ds['name']} ({ds['dataSourceId']})")
        resp = client.start_ingestion_job(
            knowledgeBaseId=kb_id,
            dataSourceId=ds["dataSourceId"],
        )
        job = resp["ingestionJob"]
        print(f"Ingestion job started: {job['ingestionJobId']}  status={job['status']}")
        return

    print("\nMultiple data sources found. KB update succeeded, but ingestion was not started.")
    print("Choose the correct data source and run start_ingestion_job manually:")
    for ds in sources:
        print(f"  {ds['dataSourceId']}  {ds['name']}")


def main():
    args = parse_args()
    cfg = load_yaml(args.yaml_file)

    kb_cfg = cfg.get("knowledge_base", {})
    kb_id = kb_cfg.get("id")
    region = kb_cfg.get("region", "us-east-1")

    if not kb_id:
        raise ValueError("knowledge_base.id is required in the YAML file.")

    generation_context = validate_context(cfg.get("generation_context", {}))

    session = make_session(args.profile, region)
    client = session.client("bedrock-agent")

    print(f"Reading existing knowledge base {kb_id} in {region} ...")
    existing = client.get_knowledge_base(knowledgeBaseId=kb_id)["knowledgeBase"]

    kb_config = copy.deepcopy(existing["knowledgeBaseConfiguration"])
    if kb_config.get("type") != "SQL":
        raise ValueError(f"Knowledge base {kb_id} is not SQL type.")

    sql_cfg = kb_config.get("sqlKnowledgeBaseConfiguration", {})
    if sql_cfg.get("type") != "REDSHIFT":
        raise ValueError("This helper currently expects a REDSHIFT SQL knowledge base.")

    redshift_cfg = sql_cfg.setdefault("redshiftConfiguration", {})
    query_gen_cfg = redshift_cfg.setdefault("queryGenerationConfiguration", {})
    query_gen_cfg["generationContext"] = generation_context

    # Keep the existing timeout if present. If no timeout exists, Bedrock can use its default.

    request = {
        "knowledgeBaseId": kb_id,
        "name": existing["name"],
        "roleArn": existing["roleArn"],
        "knowledgeBaseConfiguration": kb_config,
    }

    # UpdateKnowledgeBase overwrites supplied configuration, so preserve fields
    # returned by GetKnowledgeBase rather than rebuilding the KB from scratch.
    if existing.get("description"):
        request["description"] = existing["description"]
    if existing.get("storageConfiguration"):
        request["storageConfiguration"] = copy.deepcopy(existing["storageConfiguration"])

    print("\nGeneration context to be applied:")
    print(json.dumps(generation_context, indent=2))

    print("\nUpdating knowledge base ...")
    updated = client.update_knowledge_base(**request)["knowledgeBase"]
    print(f"Updated KB: {updated['name']} ({updated['knowledgeBaseId']})")
    print(f"Status: {updated.get('status')}")

    if not args.no_ingestion:
        start_ingestion_if_possible(client, kb_id)

    print("\nDone.")
    print("Next: open the Bedrock KB console and verify that Descriptions and Curated queries are populated, then rerun your test prompt.")


if __name__ == "__main__":
    try:
        main()
    except (ClientError, BotoCoreError, ValueError, KeyError) as e:
        print(f"\nERROR: {e}", file=sys.stderr)
        sys.exit(1)
