"""Top-level graph:

    START -> orchestrator -> (conditional: Send x N over skills | "report")
          -> skill_subgraph (x N, parallel, each a compiled sub-graph invocation)
          -> report -> END

N is however many skills survive the orchestrator's manifest filter --
nothing here assumes a fixed skill count.
"""

from langgraph.graph import END, START, StateGraph

from src.graph.nodes.orchestrator import orchestrator, route_to_skills
from src.graph.nodes.report import report_node
from src.graph.skill_subgraph.build_skill_subgraph import skill_subgraph_app
from src.graph.state import GraphState
from src.logging_setup import get_logger

logger = get_logger()


async def skill_subgraph_node(state: dict) -> dict:
    """Wraps the compiled per-skill subgraph as a single top-level node.
    One instance runs per Send() from route_to_skills; `state` here is the
    partial payload that Send carries (request_id/client_id/skill), not the
    full top-level GraphState.
    """
    skill = state["skill"]
    sub_initial_state = {
        "request_id": state["request_id"],
        "client_id": state["client_id"],
        "skill": skill,
        "worker_outputs": {},
        "result": None,
    }
    logger.info(
        "skill_subgraph_dispatch",
        request_id=state["request_id"],
        skill_id=skill["skill_id"],
        required_agent_count=len(skill["required_agents"]),
    )
    final_state = await skill_subgraph_app.ainvoke(sub_initial_state)
    return {"results": [final_state["result"]]}


def build_graph():
    graph = StateGraph(GraphState)
    graph.add_node("orchestrator", orchestrator)
    graph.add_node("skill_subgraph", skill_subgraph_node)
    graph.add_node("report", report_node)

    graph.add_edge(START, "orchestrator")
    graph.add_conditional_edges("orchestrator", route_to_skills, ["skill_subgraph", "report"])
    graph.add_edge("skill_subgraph", "report")
    graph.add_edge("report", END)

    return graph.compile()
