"""Evaluator contract + a flat dispatch dict.

No decorator-based registry (unlike fraude/skills/registry.py) -- at
MVP1's 3-skill-type scale a plain dict is simpler and does the same job.
Revisit only if the number of skill_types grows large enough that this
dict gets unwieldy.
"""

from datetime import datetime, timezone
from typing import Optional, Protocol


class Evaluator(Protocol):
    def __call__(self, skill: dict, worker_outputs: dict) -> dict: ...


def build_result(
    skill: dict,
    status: str,
    metric_value,
    worker_outputs: dict,
    error: Optional[str] = None,
) -> dict:
    return {
        "skill_id": skill["skill_id"],
        "rule_id": skill["rule_id"],
        "name": skill["name"],
        "severity": skill["severity"],
        "status": status,
        "metric_value": metric_value,
        "threshold_used": skill.get("threshold") or {},
        "worker_outputs_used": worker_outputs,
        "evaluated_at": datetime.now(timezone.utc).isoformat(),
        "error": error,
    }


def build_error_result(skill: dict, worker_outputs: dict, message: str) -> dict:
    return build_result(skill, status="ERROR", metric_value=None, worker_outputs=worker_outputs, error=message)


def _build_evaluators() -> dict:
    # Deferred import: placeholder imports `base` for build_result, so this
    # has to run after that's defined above, not at module top -- avoids a
    # circular import at load time.
    #
    # All three skill_types map to the same placeholder for now (real
    # per-rule comparison logic -- base matrix vs. real-time matrix from the
    # KB -- is intentionally not implemented yet, see placeholder.py).
    # Swapping in real logic later means adding dedicated evaluator
    # functions and pointing the relevant key(s) at them here; reduce_agent
    # and everything upstream of it stays unchanged.
    from src.graph.evaluators import placeholder

    return {
        "UCL": placeholder.evaluate,
        "VENDOR_CODE_MATCH": placeholder.evaluate,
        "PSI": placeholder.evaluate,
    }


EVALUATORS: dict[str, Evaluator] = _build_evaluators()
